/*
 * PigeonTracker nRF52840 Board Device Tree
 *
 * Copyright (c) 2026 nRFModule
 * SPDX-License-Identifier: Apache-2.0
 *
 * LiveTracker-derived board: no L76 GPS module (GNSS comes from the nRF9151
 * modem's own receiver via the serial-modem AT bridge). USB is test pads
 * only, no connector; CDC console kept for bench bring-up. An MCP73830
 * charger hangs off the USB pads, charging strategy TBD.
 *
 * Pins verified against the nRF_tracker_pigeon v1.0 netlist (2026-07-30),
 * identical to LiveTracker for every shared function.
 *
 * Hardware:
 *   - nRF52840 WLCSP (U3)
 *   - nRF9151 Cellular Modem + GNSS (M1) - via UART + DTR/RI
 *   - MX25R6435F 8MB QSPI Flash (U4)
 *   - LIS2DH12 Accelerometer (U7) - via I2C
 *   - BMP390 Barometer (U8) - via I2C
 *   - MCP73830 Battery Charger (U2) - STAT on P1.08
 *   - MFF2 eSIM on the nRF9151 SIM interface (hand-soldered)
 *   - RGB LED (D2)
 *   - User Button (SW1)
 *
 * Power Architecture:
 *   - VDD_nRF: Main MCU power (always on)
 *   - VCC_BAT_S: nRF9151 power (always on when battery present)
 *   - VDD_sensors: Sensor power (GPIO controlled)
 */

/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include <nordic/nrf52840_partition.dtsi>
#include <zephyr/dt-bindings/regulator/nrf5x.h>
#include "pigeontracker_nrf52840-pinctrl.dtsi"
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	model = "PigeonTracker nRF52840";
	compatible = "nrfmodule,pigeontracker-nrf52840";

	chosen {
		zephyr,console = &cdc_acm_uart0;
		zephyr,shell-uart = &cdc_acm_uart0;
		zephyr,uart-mcumgr = &cdc_acm_uart0;
		zephyr,bt-mon-uart = &cdc_acm_uart0;
		zephyr,bt-c2h-uart = &cdc_acm_uart0;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		/* Serial Modem UART */
		ncs_sm_uart = &uart0;
	};

	/*
	 * nRF91 modem GNSS — bus-less driver node: the receiver lives in the
	 * nRF9151 and is driven over the existing modem AT link (AT#XGNSS),
	 * so there is no peripheral or pin behind this node.
	 */
	gnss: gnss-nrf91 {
		compatible = "nrfmodule,gnss-nrf91-slm";
		status = "okay";
	};

	/*
	 * Serial Modem DTR/RI GPIO Configuration
	 *
	 * DTR: output from 52840, used to wake modem
	 * RI:  input to 52840, modem signals incoming data
	 */
	dte_dtr: dte_dtr {
		compatible = "nordic,dte-dtr";
		dtr-gpios = <&gpio0 28 GPIO_ACTIVE_HIGH>;
		ri-gpios = <&gpio0 30 GPIO_ACTIVE_HIGH>;
	};

	/* Sensor rail (TPS22916 load switch). regulator-fixed so the app gates it
	 * directly (regulator_enable/disable) and re-inits the chips over PM actions;
	 * boot-on so the I2C sensor drivers can probe at init. */
	sensor_pwr: sensor_pwr {
		compatible = "regulator-fixed";
		regulator-name = "sensor_pwr";
		enable-gpios = <&gpio1 4 GPIO_ACTIVE_HIGH>;
		regulator-boot-on;
		/* startup-delay-us is applied only at boot init; off-on-delay-us is
		 * what regulator_enable() honors on each runtime gate. Set both so the
		 * TPS22916 + sensor POR settle (~50ms) before the I2C re-init. */
		startup-delay-us = <50000>;
		off-on-delay-us = <50000>;
	};

	power_latch: power_latch {
		compatible = "regulator-fixed";
		regulator-name = "power-latch";
		enable-gpios = <&gpio0 14 GPIO_ACTIVE_HIGH>;
		regulator-boot-on;
	};

	/* nRF9151 nRESET via Q2 inverter: active (high) holds the modem in
	 * reset; 1M gate pull-down keeps it released when undriven. */
	modem_control {
		compatible = "gpio-leds";
		n91_rst: n91_rst {
			gpios = <&gpio1 2 GPIO_ACTIVE_HIGH>;
			label = "nRF9151 reset";
		};
	};

	/* MCP73830 STAT: low while charging, Hi-Z otherwise, no external pull */
	zephyr,user {
		chg-stat-gpios = <&gpio1 8 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
	};

	/*
	 * RGB LED (D2 - Common Anode, active low) on PWM0 so the status indicator
	 * can fade/mix colours. PWM_POLARITY_INVERTED -> brightness 100% = full on.
	 */
	rgb_pwm: pwmleds {
		compatible = "pwm-leds";
		pwm_led_red: pwm_led_0 {
			pwms = <&pwm0 0 PWM_MSEC(1) PWM_POLARITY_INVERTED>;
			label = "RGB red";
		};
		pwm_led_green: pwm_led_1 {
			pwms = <&pwm0 1 PWM_MSEC(1) PWM_POLARITY_INVERTED>;
			label = "RGB green";
		};
		pwm_led_blue: pwm_led_2 {
			pwms = <&pwm0 2 PWM_MSEC(1) PWM_POLARITY_INVERTED>;
			label = "RGB blue";
		};
	};

	/*
	 * User Button (SW)
	 * Active low with internal pull-up
	 */
	buttons: buttons {
		compatible = "gpio-keys";
		button0: button_0 {
			gpios = <&gpio1 9 (GPIO_ACTIVE_LOW)>;
			label = "User Button";
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	/*
	 * Battery Voltage Measurement
	 *
	 * Voltage divider (1:2): actual battery voltage = ADC reading * 2
	 */
	battery_adc: battery_adc {
		compatible = "voltage-divider";
		io-channels = <&adc 3>;
		output-ohms = <1000000>;  /* 1M bottom resistor */
		full-ohms = <2000000>;    /* 2M total */
	};

	/* Aliases for common usage */
	aliases {
		pwm-led0 = &pwm_led_red;
		pwm-led1 = &pwm_led_green;
		pwm-led2 = &pwm_led_blue;
		sw0 = &button0;
		sm-uart = &uart0;
		accel0 = &lis2dh12;
		baro0 = &bmp390;
		spi-flash0 = &mx25r64;
		poweroff = &power_latch;
	};
};

/* REG1 DC/DC mode — requires 10µH inductor on DCCH */
&reg1 {
	regulator-initial-mode = <NRF5X_REG_MODE_DCDC>;
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

/* Enable GPIOTE for GPIO interrupt/event support */
&gpiote {
	status = "okay";
};

/* RGB status LED (D2), drives rgb_pwm via three PWM0 channels */
&pwm0 {
	status = "okay";
	pinctrl-0 = <&pwm0_rgb_default>;
	pinctrl-1 = <&pwm0_rgb_sleep>;
	pinctrl-names = "default", "sleep";
};

/*
 * Serial Modem UART (nRF52840 <-> nRF9151)
 */
&uart0 {
	compatible = "nordic,nrf-uarte";
	status = "okay";
	current-speed = <921600>;
	hw-flow-control;
	pinctrl-0 = <&uart0_default>;
	pinctrl-1 = <&uart0_sleep>;
	pinctrl-names = "default", "sleep";
};

/*
 * I2C Bus for Sensors
 *
 * Devices:
 *   - LIS2DH12 @ 0x18 (accelerometer, SDO tied LOW)
 *   - BMP390 @ 0x76 (barometer, SDO tied LOW)
 */
&i2c0 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-1 = <&i2c0_sleep>;
	pinctrl-names = "default", "sleep";

	lis2dh12: lis2dh12@18 {
		compatible = "st,lis2dh12", "st,lis2dh";
		reg = <0x18>;
		irq-gpios = <&gpio1 1 GPIO_ACTIVE_HIGH>;
	};

	/*
	 * BMP390 Barometer
	 *
	 * Supported via BMP388 driver (bosch,bmp390 compatible)
	 */
	bmp390: bmp390@76 {
		compatible = "bosch,bmp390";
		reg = <0x76>;
		odr = "50";
		osr-press = <4>;
		osr-temp = <2>;
	};
};

/*
 * QSPI Flash (MX25R6435F - 8MB)
 *
 * NOTE: Partitions are NOT defined here.
 * Use overlay files to define partitions based on application needs.
 */
&qspi {
	status = "okay";
	pinctrl-0 = <&qspi_default>;
	pinctrl-1 = <&qspi_sleep>;
	pinctrl-names = "default", "sleep";

	mx25r64: mx25r6435f@0 {
		compatible = "nordic,qspi-nor";
		reg = <0>;
		sck-frequency = <8000000>;
		jedec-id = [c2 28 17];
		sfdp-bfp = [
			e5 20 f1 ff  ff ff ff 03  44 eb 08 6b  08 3b 04 bb
			ee ff ff ff  ff ff 00 ff  ff ff 00 ff  0c 20 0f 52
			10 d8 00 ff  23 72 f5 00  82 ed 04 cc  44 83 68 44
			30 b0 30 b0  f7 c4 d5 5c  00 be 29 ff  f0 d0 ff ff
		];
		size = <67108864>; /* 64 Mbit = 8 MB */
		has-dpd;
		t-enter-dpd = <10000>;
		t-exit-dpd = <35000>;
	};
};

/* ADC for battery voltage measurement */
&adc {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@3 {
		reg = <3>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN3>;
		zephyr,resolution = <12>;
	};
};

/* USB - new USBD stack (CONFIG_USB_DEVICE_STACK_NEXT).
 * Console/bring-up only: USB is exposed on test pads, no connector.
 */
zephyr_udc0: &usbd {
	compatible = "nordic,nrf-usbd";
	status = "okay";

	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
		label = "PigeonTracker";
	};
};
