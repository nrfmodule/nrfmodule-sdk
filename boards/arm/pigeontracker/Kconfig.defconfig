if BOARD_PIGEONTRACKER

config BOARD
	default "pigeontracker"

if BOARD_PIGEONTRACKER_NRF52840

config HW_STACK_PROTECTION
	default ARCH_HAS_STACK_PROTECTION

endif # BOARD_PIGEONTRACKER_NRF52840

if BOARD_PIGEONTRACKER_NRF9151 || BOARD_PIGEONTRACKER_NRF9151_NS

config HW_STACK_PROTECTION
	default ARCH_HAS_STACK_PROTECTION

config BOARD_PIGEONTRACKER
	select USE_DT_CODE_PARTITION if BOARD_PIGEONTRACKER_NRF9151_NS

endif # BOARD_PIGEONTRACKER_NRF9151 || BOARD_PIGEONTRACKER_NRF9151_NS

endif # BOARD_PIGEONTRACKER
